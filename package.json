{
    "name":  "@collidor/result",
    "version":  "0.1.2",
    "description":  "A lightweight, type-safe Result pattern implementation for robust error handling.",
    "repository":  {
                       "type":  "git",
                       "url":  "git@github.com:collidor/result.git"
                   },
    "publishConfig":  {
                          "access":  "public",
                          "provenance":  true
                      },
    "type":  "module",
    "main":  "dist/main.cjs",
    "module":  "dist/main.js",
    "types":  "dist/main.d.ts",
    "scripts":  {
                    "build":  "tsup",
                    "dev":  "tsup --watch",
                    "test":  "deno test",
                    "lint":  "oxlint",
                    "test:coverage":  "deno test --coverage && deno coverage --lcov --output=./coverage/lcov.info && deno coverage --html",
                    "publish:jsr":  "deno run --allow-all ./publishJsr.ts",
                    "sync:jsr":  "deno run --allow-read --allow-write ./sync.ts",
                    "release":  "semantic-release"
                },
    "keywords":  [
                     "result",
                     "error handling",
                     "typescript",
                     "functional"
                 ],
    "author":  "Alykam Burdzaki <alykam@gmail.com> (https://alykam.com)",
    "license":  "MIT",
    "devDependencies":  {
                            "oxlint":  "^1.78.0",
                            "tsup":  "8.5.0",
                            "typescript":  "5.9.2",
                            "semantic-release":  "^24.2.3",
                            "@semantic-release/changelog":  "^6.0.3",
                            "@semantic-release/git":  "^10.0.1",
                            "@semantic-release/exec":  "^6.0.3"
                        },
    "dependencies":  {

                     },
    "peerDependencies":  {

                         },
    "engines":  {
                    "node":  ">=24.0.0"
                }
}